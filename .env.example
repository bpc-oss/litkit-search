# ── Commercial / Institutional APIs ──────────────────────────────────
SCOPUS_API_KEY=
WOS_API_KEY=

# ── Open Scholarly APIs ──────────────────────────────────────────────
OPENALEX_API_KEY=
CROSSREF_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# ── PubMed / PMC ─────────────────────────────────────────────────────
PUBMED_EMAIL=you@example.com
PUBMED_API_KEY=

# ── OA PDF Retrieval ────────────────────────────────────────────────
UNPAYWALL_EMAIL=you@example.com

# ── Citation Verification ───────────────────────────────────────────
CITATION_VERIFIER_EMAIL=you@example.com

# ── Preprint Servers (no key needed) ────────────────────────────────
# arXiv, bioRxiv, medRxiv, ChemRxiv are open-access

# ── Institutional Access (EZProxy / on-campus) ──────────────────────
# Proxy mode: set your institution's EZProxy prefix
# INSTITUTIONAL_PROXY=https://ezproxy.youruni.edu/login?url=
# Direct mode: on-campus / VPN, no proxy prefix needed
# INSTITUTIONAL_DIRECT=true
# Cookie file (export from browser after EZProxy login)
# INSTITUTIONAL_COOKIE_FILE=C:/Users/You/cookies.txt

# ── Shadow Library fallbacks (optional download sources) ────────────
# Used as a fallback in the PDF download chain when open/institutional
# access fails. Availability varies by network; see README legal notice.
# SCIHUB_BASE_URL=https://sci-hub.se
# LIBGEN_BASE_URL=https://libgen.is
