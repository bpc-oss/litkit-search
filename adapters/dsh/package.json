{
  "name": "@bpshil/litkit-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin adapter for litkit — academic literature search, citation audit, and download tools in any dsh profile.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "SKILL.md",
    "README.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "litkit",
    "literature",
    "academic",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bpshil/litkit-search.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=20"
  }
}
